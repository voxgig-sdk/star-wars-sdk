# Entity: planet

main: kit: entity: planet: {

  alias: field: {}

  fields: [
    {
      name: "climate"
      req: false
      short: "The climate of this planet"
      type: "`$STRING`"
    }
    {
      name: "created"
      req: false
      short: "The ISO 8601 date format of the time that this resource was created"
      type: "`$STRING`"
    }
    {
      name: "diameter"
      req: false
      short: "The diameter of this planet in kilometers"
      type: "`$STRING`"
    }
    {
      name: "edited"
      req: false
      short: "The ISO 8601 date format of the time that this resource was edited"
      type: "`$STRING`"
    }
    {
      name: "films"
      req: false
      short: "An array of Film URL Resources that this planet has appeared in"
      type: "`$ARRAY`"
    }
    {
      name: "gravity"
      req: false
      short: "A number denoting the gravity of this planet"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "The name of this planet"
      type: "`$STRING`"
    }
    {
      name: "orbital_period"
      req: false
      short: "The number of standard days it takes for this planet to complete a single orbit of its local star"
      type: "`$STRING`"
    }
    {
      name: "population"
      req: false
      short: "The average population of sentient beings inhabiting this planet"
      type: "`$STRING`"
    }
    {
      name: "residents"
      req: false
      short: "An array of People URL Resources that live on this planet"
      type: "`$ARRAY`"
    }
    {
      name: "rotation_period"
      req: false
      short: "The number of standard hours it takes for this planet to complete a single rotation on its axis"
      type: "`$STRING`"
    }
    {
      name: "surface_water"
      req: false
      short: "The percentage of the planet surface that is naturally occurring water"
      type: "`$STRING`"
    }
    {
      name: "terrain"
      req: false
      short: "The terrain of this planet"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "The hypermedia URL of this resource"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "planet"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "search"
                orig: "search"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/planets"
          parts: [
            "planets"
          ]
          select: {
            exist: [
              "page"
              "search"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/planets/{id}"
          parts: [
            "planets"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
