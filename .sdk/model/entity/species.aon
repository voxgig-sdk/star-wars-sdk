# Entity: species

main: kit: entity: species: {

  alias: field: {}

  fields: [
    {
      name: "average_height"
      req: false
      short: "The average height of this species in centimeters"
      type: "`$STRING`"
    }
    {
      name: "average_lifespan"
      req: false
      short: "The average lifespan of this species in years"
      type: "`$STRING`"
    }
    {
      name: "classification"
      req: false
      short: "The classification of this species"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "created"
      req: false
      short: "The ISO 8601 date format of the time that this resource was created"
      type: "`$STRING`"
    }
    {
      name: "designation"
      req: false
      short: "The designation of this species"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "edited"
      req: false
      short: "The ISO 8601 date format of the time that this resource was edited"
      type: "`$STRING`"
    }
    {
      name: "eye_colors"
      req: false
      short: "A comma-separated string of common eye colors for this species"
      type: "`$STRING`"
    }
    {
      name: "films"
      req: false
      short: "An array of Film URL Resources that this species has appeared in"
      type: "`$ARRAY`"
    }
    {
      name: "hair_colors"
      req: false
      short: "A comma-separated string of common hair colors for this species"
      type: "`$STRING`"
    }
    {
      name: "homeworld"
      req: false
      short: "The URL of a planet resource that is the homeworld of this species"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "language"
      req: false
      short: "The language commonly spoken by this species"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "The name of this species"
      type: "`$STRING`"
    }
    {
      name: "people"
      req: false
      short: "An array of People URL Resources that are a part of this species"
      type: "`$ARRAY`"
    }
    {
      name: "skin_colors"
      req: false
      short: "A comma-separated string of common skin colors for this species"
      type: "`$STRING`"
    }
    {
      name: "url"
      req: false
      short: "The hypermedia URL of this resource"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "species"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "search"
                orig: "search"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/species"
          segments: [
            {
              lit: "species"
            }
          ]
          select: {
            exist: [
              "page"
              "search"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/species/{id}"
          segments: [
            {
              lit: "species"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
