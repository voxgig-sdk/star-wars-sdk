      t: "`$STRING`"
    }
    mass: {
      h: "Mass"
      n: "mass"
      r: false
      sh: "The mass of the person in kilograms"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of this person"
      t: "`$STRING`"
    }
    skin_color: {
      h: "Skin Color"
