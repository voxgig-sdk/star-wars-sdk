  id: {
    field: "id"
    name: "id"
  }

  name: "person"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /people"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "search"
                or: "search"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/people"
          q: {
            exist: [
              "page"
              "search"
            ]
          }
          s: [
            {
              lit: "people"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /people/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/people/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "people"
            }
            {
              var: "id"
            }
          ]
          t: {
