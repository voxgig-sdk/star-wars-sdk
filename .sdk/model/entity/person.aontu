      sh: "The birth year of the person, using the in-universe standard of BBY or ABY"
      t: "`$STRING`"
    }
    created: {
      fo: "date-time"
      h: "Created"
      n: "created"
      r: false
      sh: "The ISO 8601 date format of the time that this resource was created"
