# Entity: vehicle

main: kit: entity: vehicle: {

  alias: field: {}

  fields: [
    {
      name: "cargo_capacity"
      req: false
      short: "The maximum number of kilograms that this vehicle can transport"
      type: "`$STRING`"
    }
    {
      name: "consumables"
      req: false
      short: "The maximum length of time that this vehicle can provide consumables for its entire crew without having to resupply"
      type: "`$STRING`"
    }
    {
      name: "cost_in_credits"
      req: false
      short: "The cost of this vehicle new, in galactic credits"
      type: "`$STRING`"
    }
    {
      name: "created"
      req: false
      short: "The ISO 8601 date format of the time that this resource was created"
      type: "`$STRING`"
    }
    {
      name: "crew"
      req: false
      short: "The number of personnel needed to run or pilot this vehicle"
      type: "`$STRING`"
    }
    {
      name: "edited"
      req: false
      short: "The ISO 8601 date format of the time that this resource was edited"
      type: "`$STRING`"
    }
    {
      name: "films"
      req: false
      short: "An array of Film URL Resources that this vehicle has appeared in"
      type: "`$ARRAY`"
    }
    {
      name: "length"
      req: false
      short: "The length of this vehicle in meters"
      type: "`$STRING`"
    }
    {
      name: "manufacturer"
      req: false
      short: "The manufacturer of this vehicle"
      type: "`$STRING`"
    }
    {
      name: "max_atmosphering_speed"
      req: false
      short: "The maximum speed of this vehicle in atmosphere"
      type: "`$STRING`"
    }
    {
      name: "model"
      req: false
      short: "The model or official name of this vehicle"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "The name of this vehicle"
      type: "`$STRING`"
    }
    {
      name: "passengers"
      req: false
      short: "The number of non-essential people this vehicle can transport"
      type: "`$STRING`"
    }
    {
      name: "pilots"
      req: false
      short: "An array of People URL Resources that this vehicle has been piloted by"
      type: "`$ARRAY`"
    }
    {
      name: "url"
      req: false
      short: "The hypermedia URL of this resource"
      type: "`$STRING`"
    }
    {
      name: "vehicle_class"
      req: false
      short: "The class of this vehicle"
      type: "`$STRING`"
    }
  ]

  name: "vehicle"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "search"
                orig: "search"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/vehicles"
          parts: [
            "vehicles"
          ]
          select: {
            exist: [
              "page"
              "search"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/vehicles/{id}"
          parts: [
            "vehicles"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
