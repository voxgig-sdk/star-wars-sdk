# Entity: starship

main: kit: entity: starship: {

  alias: field: {}

  fields: {
    MGLT: {
      h: "Mglt"
      n: "MGLT"
      r: false
      sh: "The Maximum number of Megalights this starship can travel in a standard hour"
      t: "`$STRING`"
    }
    cargo_capacity: {
      h: "Cargo Capacity"
      n: "cargo_capacity"
      r: false
      sh: "The maximum number of kilograms that this starship can transport"
      t: "`$STRING`"
    }
    consumables: {
      h: "Consumables"
      n: "consumables"
      r: false
      sh: "The maximum length of time that this starship can provide consumables for its entire crew without having to resupply"
      t: "`$STRING`"
    }
    cost_in_credits: {
      h: "Cost In Credits"
      n: "cost_in_credits"
      r: false
      sh: "The cost of this starship new, in galactic credits"
      t: "`$STRING`"
    }
    created: {
      fo: "date-time"
      h: "Created"
      n: "created"
      r: false
      sh: "The ISO 8601 date format of the time that this resource was created"
      t: "`$STRING`"
    }
    crew: {
      h: "Crew"
      n: "crew"
      r: false
      sh: "The number of personnel needed to run or pilot this starship"
      t: "`$STRING`"
    }
    edited: {
      fo: "date-time"
      h: "Edited"
      n: "edited"
      r: false
      sh: "The ISO 8601 date format of the time that this resource was edited"
      t: "`$STRING`"
    }
    films: {
      h: "Films"
      n: "films"
      r: false
      sh: "An array of Film URL Resources that this starship has appeared in"
      t: "`$ARRAY`"
    }
    hyperdrive_rating: {
      h: "Hyperdrive Rating"
      n: "hyperdrive_rating"
      r: false
      sh: "The class of this starships hyperdrive"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    length: {
      h: "Length"
      n: "length"
      r: false
      sh: "The length of this starship in meters"
      t: "`$STRING`"
    }
    manufacturer: {
      h: "Manufacturer"
      n: "manufacturer"
      r: false
      sh: "The manufacturer of this starship"
      t: "`$STRING`"
    }
    max_atmosphering_speed: {
      h: "Max Atmosphering Speed"
      n: "max_atmosphering_speed"
      r: false
      sh: "The maximum speed of this starship in atmosphere"
      t: "`$STRING`"
    }
    model: {
      h: "Model"
      n: "model"
      r: false
      sh: "The model or official name of this starship"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of this starship"
      t: "`$STRING`"
    }
    passengers: {
      h: "Passengers"
      n: "passengers"
      r: false
      sh: "The number of non-essential people this starship can transport"
      t: "`$STRING`"
    }
    pilots: {
      h: "Pilots"
      n: "pilots"
      r: false
      sh: "An array of People URL Resources that this starship has been piloted by"
      t: "`$ARRAY`"
    }
    starship_class: {
      h: "Starship Class"
      n: "starship_class"
      r: false
      sh: "The class of this starship"
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: false
      sh: "The hypermedia URL of this resource"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "starship"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /starships"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                k: "query"
                n: "search"
                or: "search"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/starships"
          q: {
            exist: [
              "page"
              "search"
            ]
          }
          s: [
            {
              lit: "starships"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /starships/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/starships/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "starships"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
